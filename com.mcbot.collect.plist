<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mcbot.collect</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/MCBot/.venv/bin/python3</string>
        <string>-m</string>
        <string>mcbot.collect</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/MCBot</string>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/.mcbot/logs/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/.mcbot/logs/stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
